<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore. Every NuGet package this project needs is in vendor/nuget, so `dotnet build`
  works without internet access. The <clear /> lines switch off nuget.org and any machine-wide
  sources or package folders, so a build can only use what is in this folder.

  After changing a package version in CodeGraph.csproj, refresh vendor/nuget (see CLAUDE.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="CodeGraph offline packages" value="vendor/nuget" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
